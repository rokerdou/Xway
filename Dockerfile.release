# Release-repository image: expects a precompiled `server` binary at the root.
FROM debian:bookworm-slim
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates netcat-openbsd \
    && rm -rf /var/lib/apt/lists/* \
    && (id -u proxy >/dev/null 2>&1 || useradd --create-home --shell /usr/sbin/nologin proxy)

WORKDIR /app
COPY server /app/server
COPY server.toml /app/server.toml
RUN chmod 0755 /app/server && chown -R proxy:proxy /app

USER proxy
EXPOSE 1080
ENV RUST_LOG=info
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
  CMD nc -z 127.0.0.1 1080 || exit 1
CMD ["/app/server", "--config", "/app/server.toml"]
